  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@cloudflare/workers-types": "5.20261101.1",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "4.1.12",
    "typescript": "5.9.3",
